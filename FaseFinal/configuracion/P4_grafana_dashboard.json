{
  "id": null,
  "uid": "zenite-snmp",
  "title": "Zenite · Monitoreo SNMP",
  "tags": [
    "zenite",
    "p4",
    "snmp"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Respuesta SNMP por host",
      "type": "stat",
      "description": "0: sin respuesta; no equivale por sí solo a EC2 apagada. Revisar también recolector.",
      "datasource": {
        "type": "prometheus",
        "uid": "zenite-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"snmp\",host=~\"$host\"}",
          "legendFormat": "{{host}}",
          "range": false,
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "zenite-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Sin respuesta",
                  "color": "red"
                },
                "1": {
                  "text": "Responde",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "Recolector SNMP",
      "type": "stat",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "zenite-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"snmp_exporter\"}",
          "legendFormat": "Recolector",
          "range": false,
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "zenite-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Sin respuesta",
                  "color": "red"
                },
                "1": {
                  "text": "Responde",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "title": "CPU media por host",
      "type": "timeseries",
      "description": "Carga porcentual informada por cada procesador, media por host; promedio aproximado del último minuto.",
      "datasource": {
        "type": "prometheus",
        "uid": "zenite-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg by(host) (hrProcessorLoad{job=\"snmp\",host=~\"$host\"})",
          "legendFormat": "{{host}}",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "zenite-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "title": "RAM física utilizada",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "zenite-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * hrStorageUsed{job=\"snmp\",host=~\"$host\",hrStorageDescr=\"Physical memory\"} / hrStorageSize{job=\"snmp\",host=~\"$host\",hrStorageDescr=\"Physical memory\"}",
          "legendFormat": "{{host}}",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "zenite-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "title": "Tráfico recibido",
      "type": "timeseries",
      "description": "Necesita dos o más muestras. Ausencia de datos no se sustituye por cero.",
      "datasource": {
        "type": "prometheus",
        "uid": "zenite-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "8 * rate(ifHCInOctets{job=\"snmp\",host=~\"$host\",ifName!=\"lo\"}[2m])",
          "legendFormat": "{{host}} · {{ifName}}",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "zenite-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "title": "Tráfico enviado",
      "type": "timeseries",
      "description": "Necesita dos o más muestras. Ausencia de datos no se sustituye por cero.",
      "datasource": {
        "type": "prometheus",
        "uid": "zenite-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "8 * rate(ifHCOutOctets{job=\"snmp\",host=~\"$host\",ifName!=\"lo\"}[2m])",
          "legendFormat": "{{host}} · {{ifName}}",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "zenite-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "title": "Disco raíz utilizado",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "zenite-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "dskPercent{job=\"snmp\",host=~\"$host\",dskPath=\"/\"}",
          "legendFormat": "{{host}}",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "zenite-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "title": "Uptime del agente SNMP",
      "type": "stat",
      "description": "Tiempo del agente SNMP, no necesariamente uptime del sistema operativo.",
      "datasource": {
        "type": "prometheus",
        "uid": "zenite-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sysUpTime{job=\"snmp\",host=~\"$host\"} / 100",
          "legendFormat": "{{host}}",
          "range": false,
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "zenite-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 9,
      "title": "Hosts sin respuesta SNMP",
      "type": "stat",
      "description": "Estado visible para GRAF-03; revisar recolector, EC2, red y agente. Incluye paradas intencionales.",
      "datasource": {
        "type": "prometheus",
        "uid": "zenite-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(up{job=\"snmp\",host=~\"$host\"} == 0) or vector(0)",
          "legendFormat": "Sin respuesta",
          "range": false,
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "zenite-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 10,
      "title": "Procesos declarados",
      "type": "stat",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "zenite-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "prCount{job=\"snmp\",host=~\"$host\"}",
          "legendFormat": "{{host}} · {{prNames}}",
          "range": false,
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "zenite-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "zenite-prometheus"
        },
        "query": "label_values(up{job=\"snmp\"}, host)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  }
}
