[Unit]
Description=Portal de gestiones de Zenite Prestige (gunicorn)
After=network.target

[Service]
User=zenite-portal
Group=zenite-portal
WorkingDirectory=/opt/zenite-portal
Environment=ZENITE_DB=/var/lib/zenite-portal/gestiones.db
ExecStart=/usr/bin/gunicorn --bind 127.0.0.1:8000 --workers 2 app:app
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/zenite-portal

[Install]
WantedBy=multi-user.target
