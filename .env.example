# Plantilla de variables sensibles del proyecto.
# Copiar a .env (en la raíz del repositorio) y llenar solo en la máquina local:
#   cp .env.example .env
# .env está en .gitignore: NUNCA se sube al repositorio. Este archivo solo lleva los nombres, sin valores reales.
#
# En AWS CloudShell no hace falta: la sesión de la consola ya trae las credenciales.
# Los scripts de Fase2/configuracion/ cargan .env automáticamente si existe.

# --- AWS CLI (solo si se ejecutan los scripts fuera de CloudShell) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Solo para credenciales temporales (AWS Academy / Learner Lab / SSO)
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1

# --- Llaves SSH (ruta local al archivo; el .pem/.key nunca se copia al repositorio) ---
# En Fase 2 las instancias se administran con EC2 Instance Connect Endpoint y no requieren llave.
EC2_KEY_PAIR_NAME=
EC2_KEY_PATH=

# --- Contraseñas de servicios (fases posteriores: OpenLDAP, PostgreSQL) ---
LDAP_ADMIN_PASSWORD=
POSTGRES_PASSWORD=
